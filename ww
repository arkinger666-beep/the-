-- Drag
local dragging, dragStart, startPos
Title.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        dragStart = input.Position
        startPos = Main.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then dragging = false end
        end)
    end
end)
UserInputService.InputChanged:Connect(function(input)
    if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
        local delta = input.Position - dragStart
        Main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

-- ================= LOGIC =================
local function getHRP()
    local char = LocalPlayer.Character
    if not char then return nil end
    return char:FindFirstChild("HumanoidRootPart")
end

local function isCoin(obj)
    if not (obj:IsA("BasePart") or obj:IsA("MeshPart") or obj:IsA("UnionOperation")) then
        return false
    end
    local name = obj.Name:lower()
    local parentName = obj.Parent and obj.Parent.Name:lower() or ""
    for _, key in pairs(coinKeywords) do
        if name:find(key) or parentName:find(key) then
            return true
        end
    end
    -- تشخیص تقریبی سکه‌های طلایی/نئونی کوچک
    if obj.Size.Magnitude < 6 then
        local color = obj.BrickColor.Name:lower()
        if color:find("gold") or color:find("yellow") or color:find("neon") or obj.Material == Enum.Material.Neon then
            return true
        end
    end
    return false
end

local function findCoins()
    local coins = {}
    for _, obj in pairs(workspace:GetDescendants()) do
        if isCoin(obj) then
            table.insert(coins, obj)
        end
    end
    return coins
end

local function collectCoins()
    if collecting then return end
    collecting = true

    local hrp = getHRP()
    if not hrp then
        collecting = false
        return
    end

    local originalCF = hrp.CFrame
    local coins = findCoins()

    if #coins == 0 then
        Status.Text = "No coins found"
        collecting = false
        return
    end

    Status.Text = "Collecting " .. #coins .. " coins..."

    -- خیلی سریع به سکه‌ها برو
    for i, coin in ipairs(coins) do
        if coin and coin.Parent then
            hrp.CFrame = CFrame.new(coin.Position + Vector3.new(0, 3, 0))
            -- یه تاچ کوچیک
            firetouchinterest(hrp, coin, 0)
            firetouchinterest(hrp, coin, 1)
            task.wait(0.03) -- خیلی کم صبر کن
        end
    end

    -- برگرد جای اول
    hrp.CFrame = originalCF
    hrp.AssemblyLinearVelocity = Vector3.zero

    Status.Text = "Done! Collected " .. #coins
    task.wait(1.2)
    Status.Text = "Waiting for new map..."
    collecting = false
end

-- تشخیص مپ جدید (ساده)
local lastPartCount = 0
RunService.Heartbeat:Connect(function()
    if not enabled or collecting then return end
    if tick() - lastMapCheck < 1.5 then return end
    lastMapCheck = tick()

    local currentCount = #workspace:GetDescendants()
    -- اگه تعداد اشیاء مپ یهو زیاد شد = مپ جدید لود شده
    if currentCount > lastPartCount + 80 then
        task.wait(0.4) -- یه کم صبر کن تا سکه‌ها لود بشن
        collectCoins()
    end
    lastPartCount = currentCount
end)

